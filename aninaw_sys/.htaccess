# ANINAW — Apache settings (XAMPP / shared hosting)

Options -Indexes
DirectoryIndex index.php

# Never serve dotfiles (.env, .htaccess, .git) or SQL/log/markdown files.
<FilesMatch "^\.">
    Require all denied
</FilesMatch>
<FilesMatch "\.(sql|log|md|example|ini|sh)$">
    Require all denied
</FilesMatch>

# Friendly error pages. If you install somewhere other than htdocs/aninaw_sys,
# change the paths below (they are web paths, not file paths).
ErrorDocument 403 /aninaw_sys/403.php
ErrorDocument 404 /aninaw_sys/404.php

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "same-origin"
</IfModule>
