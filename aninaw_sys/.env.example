# ANINAW configuration. Copy this file to ".env" and adjust the values.
# .env is blocked from web access by .htaccess. Never commit your real .env.

# production | development
APP_ENV=production
# Show PHP errors on screen (only honoured when APP_ENV=development)
APP_DEBUG=false
# Public URL of this folder. Leave empty to auto-detect.
# Set it if links or assets break, e.g. http://localhost/aninaw_sys
APP_URL=
APP_TIMEZONE=Asia/Manila

# Database (XAMPP default: user root with an empty password)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=aninaw_db
DB_USER=root
DB_PASS=

# Seconds of inactivity before automatic sign-out, and maximum session length
SESSION_IDLE_TIMEOUT=1800
SESSION_ABSOLUTE_TIMEOUT=28800

# Login throttling: failed attempts allowed per account / per IP within the window
LOGIN_MAX_ATTEMPTS=5
LOGIN_MAX_IP_ATTEMPTS=30
LOGIN_WINDOW_MINUTES=15
